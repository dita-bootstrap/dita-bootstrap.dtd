<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//DITA Bootstrap//DTD DITA Bootstrap Topic//EN" "bootstrap-topic.dtd">
<topic id="spacing">
  <title>Spacing</title>
  <shortdesc>Use margin and padding utilities to quickly control the layout of elements. The <xmlatt
    >margin</xmlatt> and <xmlatt
    >padding</xmlatt> attributes enable standard Bootstrap spacing across a range of DITA components.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Spacing</indexterm>
        <indexterm>Margin</indexterm>
        <indexterm>Padding</indexterm>
        <indexterm>CSS
          <indexterm><xmlatt>outputclass</xmlatt></indexterm>
        </indexterm>
        <indexterm><xmlatt>margin</xmlatt></indexterm>
        <indexterm><xmlatt>padding</xmlatt></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <body outputclass="language-markup">
    <section id="margin">
      <title>Margin</title>
      <p>The <xmlatt
        >margin</xmlatt> attribute controls the distance between elements, supporting values from 0 to 12 and <codeph
        >auto</codeph>.</p>
    </section>

    <example>
      <div theme="primary-contrast" margin="0" padding="2">Margin 0</div>
      <div theme="secondary-contrast" margin="1" padding="2">Margin 1</div>
      <div theme="success-contrast" margin="2" padding="2">Margin 2</div>
      <div theme="danger-contrast" margin="3" padding="2">Margin 3</div>
      <div theme="warning-contrast" margin="4" padding="2">Margin 4</div>
      <div theme="info-contrast" margin="5" padding="2">Margin 5</div>
      <div theme="primary-contrast" margin="6" padding="2">Margin 6</div>
      <div theme="secondary-contrast" margin="12" padding="2">Margin 12</div>
      <div theme="accent-contrast" margin="auto" padding="2" width="50">Margin Auto</div>
    </example>

    <codeblock><coderef href="code/spacing/margin.xml"/></codeblock>

    <section id="padding">
      <title>Padding</title>
      <p>The <xmlatt
        >padding</xmlatt> attribute controls the internal spacing of an element, supporting values from 0 to 12.</p>
    </section>

    <example>
      <div theme="primary-contrast" padding="0">Padding 0</div>
      <div theme="secondary-contrast" padding="1" margin="1"><div
          width="100"
          outputclass="theme-secondary theme-subtle"
        >Padding 1</div></div>
      <div theme="success-contrast" padding="2" margin="1"><div
          width="100"
          outputclass="theme-success theme-subtle"
        >Padding 2</div></div>
      <div theme="danger-contrast" padding="3" margin="1"><div
          width="100"
          outputclass="theme-danger theme-subtle"
        >Padding 3</div></div>
      <div theme="warning-contrast" padding="4" margin="1"><div
          width="100"
          outputclass="theme-warning theme-subtle"
        >Padding 4</div></div>
      <div theme="info-contrast" padding="5" margin="1"><div
          width="100"
          outputclass="theme-info theme-subtle"
        >Padding 5</div></div>
      <div theme="primary-contrast" padding="6" margin="1"><div
          width="100"
          outputclass="theme-primary theme-subtle"
        >Padding 6</div></div>
      <div theme="secondary-contrast" padding="12" margin="1"><div
          width="100"
          outputclass="theme-secondary theme-subtle"
        >Padding 12</div></div>
    </example>

    <codeblock><coderef href="code/spacing/padding.xml"/></codeblock>

    <section id="directional-spacing">
      <title>Directional Spacing</title>
      <p>The <xmlatt>margin</xmlatt> and <xmlatt
        >padding</xmlatt> attributes also support directional spacing using a prefix:</p>
      <ul>
        <li><codeph>t</codeph> - Top</li>
        <li><codeph>b</codeph> - Bottom</li>
        <li><codeph>s</codeph> - Start (Left in LTR)</li>
        <li><codeph>e</codeph> - End (Right in LTR)</li>
        <li><codeph>x</codeph> - Horizontal (Start and End)</li>
        <li><codeph>y</codeph> - Vertical (Top and Bottom)</li>
      </ul>
      <p>Multiple values can be specified as a space-separated list.</p>
    </section>

    <example>
      <div theme="primary-contrast" margin="t5 b0">Margin Top 5, Bottom 0</div>
      <div theme="secondary-contrast" margin="x3">Margin Horizontal 3</div>
      <div theme="success-contrast" padding="y5"><div width="100" theme="success-subtle">Padding Vertical 5</div></div>
      <div theme="danger-contrast" padding="s3 e1"><div
          width="100"
          theme="danger-subtle"
        >Padding Start 3, End 1</div></div>
    </example>

    <codeblock><coderef href="code/spacing/directional-spacing.xml"/></codeblock>
  </body>
</topic>
